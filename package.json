{
  "name": "@delok/sdk",
  "version": "0.1.0",
  "description": "Official TypeScript SDK for sending logs to the Delok Observability Platform.",
  "license": "MIT",
  "author": "Yuanda Dhama Prandita",
  "homepage": "https://github.com/yuandadhama/delok-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuandadhama/delok-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/yuandadhama/delok-sdk/issues"
  },
  "keywords": [
    "delok",
    "logging",
    "monitoring",
    "typescript",
    "sdk"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  }
}
